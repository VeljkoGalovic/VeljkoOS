# Copy to .env and adjust. The values below are the local-development defaults.

# The async driver prefix is required: both the app and Alembic run on
# SQLAlchemy's asyncio engine. Host is `localhost` for a local run;
# docker-compose.yml overrides this to `db` for the container network.
DATABASE_URL=postgresql+asyncpg://veljko:veljko@localhost:5432/veljkoos

APP_NAME=VeljkoOS Core
DEBUG=false

# Consumed by the `db` service in docker-compose.yml. Keep these in sync with
# the credentials embedded in DATABASE_URL above.
POSTGRES_USER=veljko
POSTGRES_PASSWORD=veljko
POSTGRES_DB=veljkoos
